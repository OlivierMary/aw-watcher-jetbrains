<idea-plugin>
    <id>fr.mary.olivier.aw-watcher</id>
    <name>Activity Watcher</name>
    <vendor email="olivier@omary.fr" url="https://github.com/OlivierMary">OlivierMARY</vendor>

    <description><![CDATA[
    This extension allows the open source tracking tool ActivityWatch to keep track of the projects and coding languages you use in jetbrains IDEs.
    ]]></description>

    <depends>com.intellij.modules.lang</depends>
    <depends>com.intellij.modules.platform</depends>
    <depends>Git4Idea</depends>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="Activity Watcher" displayType="BALLOON"/>
        <!-- starts the service (connection to ActivityWatch) as soon as an editor is opened -->
        <editorFactoryListener implementation="fr.mary.olivier.aw.watcher.listener.RAEditorFactoryListener"/>
        <editorFactoryDocumentListener implementation="fr.mary.olivier.aw.watcher.listener.RADocumentListener"/>
        <editorFactoryMouseListener implementation="fr.mary.olivier.aw.watcher.listener.RAEditorMouseListener"/>
    </extensions>

    <applicationListeners>
        <listener class="fr.mary.olivier.aw.watcher.listener.RASaveListener"
                  topic="com.intellij.openapi.fileEditor.FileDocumentManagerListener"/>
    </applicationListeners>

    <actions>
        <action id="fr.mary.olivier.aw-watcher.aw-watcher.Info"
                class="fr.mary.olivier.aw.watcher.InfoAction"
                text="Activity Watcher Informations" description="Activity watcher informations">
        </action>
    </actions>
</idea-plugin>
